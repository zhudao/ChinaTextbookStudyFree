  "knowledge_summary": [
    {
      "point": "乘法的初步认识",
      "core_concept": "求几个相同加数的和，可以用乘法表示。乘号两边是乘数，结果是积。",
      "key_formula": "相同加数×相同加数的个数=总数。",
      "common_mistakes": [
        "不同加数直接相加，不能随便改写为一个乘法算式。"
      ],
      "tips": "先找每份几个，再找有几份。"
    },
    {
      "point": "5的乘法口诀",
      "core_concept": "5的乘法口诀表示几个5相加，积依次增加5。",
      "key_formula": "一五得五，二五一十，三五十五，四五二十，五五二十五。",
      "common_mistakes": [
        "几个5相加不能误算成5加上几。"
      ],
      "tips": "忘记一句时，可以从前一句的结果再加5。"
    },
    {
      "point": "2、3、4的乘法口诀",
      "core_concept": "用2、3、4的乘法口诀求相应的积。交换两个乘数的位置，积不变。",
      "key_formula": "二三得六，三四十二，四四十六。",
      "common_mistakes": [
        "区别乘数和积，不要把2×4算成2+4。"
      ],
      "tips": "可以用连续加相同的数检查口诀。"
    },
    {
      "point": "乘加、乘减",
      "core_concept": "规则排列中多出或少了几个，可以先算整齐部分，再加上或减去。",
      "key_formula": "在不含括号的乘加、乘减算式中，先乘后加减。",
      "common_mistakes": [
        "不要把先算乘法误记成一律从左向右。"
      ],
      "tips": "把完整的几组圈出来，再处理多余或缺少的部分。"
    },
    {
      "point": "6的乘法口诀",
      "core_concept": "用6的乘法口诀计算几个6相加的结果。",
      "key_formula": "一六得六，二六十二，三六十八，四六二十四，五六三十，六六三十六。",
      "common_mistakes": [
        "别把四六二十四和四五二十混淆。"
      ],
      "tips": "相邻两个结果相差6，可以用加减6检查。"
    },
    {
      "point": "1～6乘法整理和复习",
      "core_concept": "根据每份数和份数选择乘法，把算式、口诀与实际问题联系起来。",
      "key_formula": "每份数×份数=总数。",
      "common_mistakes": [
        "求两个不同数量的和用加法，不要看到两个数就用乘法。"
      ],
      "tips": "先说清每个数表示什么，再列式。"
    }
  ]
