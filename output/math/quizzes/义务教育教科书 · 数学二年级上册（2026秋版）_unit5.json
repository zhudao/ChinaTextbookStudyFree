      "common_mistakes": [
        "读清除数，不能看到同样的被除数就用同一个商。"
      ],
      "tips": "先说口诀，再列除法算式。"
    },
    {
      "point": "7～9乘除法整理和应用",
      "core_concept": "已知每份数和份数求总数用乘法；已知总数求每份数或份数用除法。",
      "key_formula": "每份数×份数=总数；总数÷每份数=份数。",
      "common_mistakes": [
        "读题时先确定未知的是总数、份数还是每份数。"
      ],
      "tips": "用一句话说明为什么选乘法或除法。"
