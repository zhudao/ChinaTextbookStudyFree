  "knowledge_summary": [
    {
      "point": "平均分：求每份多少",
      "core_concept": "每份分得同样多叫平均分。已知总数和份数，可以求每份的数量。",
      "key_formula": "总数÷份数=每份数。",
      "common_mistakes": [
        "平均分要求每份同样多，不能只看是否分完。"
      ],
      "tips": "分完后比较每一份，再把各份合起来检查总数。"
    },
    {
      "point": "平均分：求有几份",
      "core_concept": "每几个分成一份，求能分成几份，也可以用除法。",
      "key_formula": "总数÷每份数=份数。",
      "common_mistakes": [
        "区分题目是在问每份几个，还是一共有几份。"
      ],
      "tips": "用圈一圈、分一分的方法理解每份数与份数。"
    },
    {
      "point": "除法的认识与口诀求商",
      "core_concept": "除法表示平均分。用乘法口诀想几乘除数等于被除数，就能求出商。",
      "key_formula": "被除数÷除数=商；商×除数=被除数。",
      "common_mistakes": [
        "除数不能是0；除法算式中各数有自己的名称。"
      ],
      "tips": "把除法变成想乘法，用乘法验算。"
    },
    {
      "point": "1～6除法整理和应用",
      "core_concept": "根据平均分的两种情况列除法算式，并联系乘法检查结果。",
      "key_formula": "求每份数或份数都可以用除法。",
      "common_mistakes": [
        "不要把求总数的乘法问题与平均分的除法问题混淆。"
      ],
      "tips": "画出每份的分组，再说明商的意思。"
    }
  ]
