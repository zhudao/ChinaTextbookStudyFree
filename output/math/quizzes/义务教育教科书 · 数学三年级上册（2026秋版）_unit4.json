  "knowledge_summary": [
    {
      "common_mistakes": [
        "整十、整百数乘一位数时，忘记积所对应的十或百。",
        "把两位数拆分后，漏加其中一部分的积。",
        "把相同加数的个数与每个加数的大小混淆。"
      ],
      "core_concept": "把整十、整百、整千数看作若干个十、百、千来口算；也可以把两位数拆成几十和几，分别与一位数相乘后再相加。",
      "key_formula": "20×3＝60；200×3＝600；12×3＝10×3＋2×3＝36",
      "point": "口算乘法与算理",
      "tips": "先看有几个十、百或千，再用表内乘法计算；拆分计算时，各部分都要乘，最后把积相加。"
    },
    {
      "common_mistakes": [
        "笔算时没有从个位起依次计算。",
        "某一位计算满十时忘记进位，或下一位漏加进位。",
        "连续进位时，只看该位数字相乘的积，没有把进来的数一起计算。"
      ],
      "core_concept": "笔算时，相同数位对齐，从个位起，用一位数依次乘多位数的每一位，并加上前一位进来的数；满几十就向前一位进几。",
      "key_formula": "每一位的计算结果＝该位数字×一位数＋前一位进来的数",
      "point": "笔算乘法与连续进位",
      "tips": "每算一位都检查是否需要进位；最高位计算后若仍有进位，要把它写在积的前面。算完可以用估算检查结果是否合理。"
    },
    {
      "common_mistakes": [
        "乘数中间有0时漏算该数位，或漏加前一位进来的数。",
        "乘数末尾有0时，计算后忘记在积的末尾添上相应个数的0。",
        "误以为多位数中只要含有0，乘积就一定是0。"
      ],
      "core_concept": "0和任何数相乘都得0。多位数中间有0时，仍要逐位计算并处理进位；末尾有0时，可以先算末尾0前面的数与一位数的积，再在所得数的末尾添上相应个数的0。",
      "key_formula": "604×8＝4832；280×3＝28×3×10＝840",
      "point": "乘数中间或末尾有0的乘法",
      "tips": "中间的0不能漏算，还要加上前一位进来的数。末尾有0时，先算末尾0前面的数，再添上原来末尾相应个数的0。"
    },
    {
      "common_mistakes": [
        "估算时不根据题意判断应把数往大估还是往小估。",
        "把估算结果当作精确结果。",
        "解决实际问题时漏掉必要条件，例如限乘人数中包括司机。"
      ],
      "core_concept": "根据题意选择估算或精算。求相同几份的总量，可以用每份数量乘份数；判断够不够时，要注意估算方向，只有估算结果能够支持结论时才能直接作答。",
      "key_formula": "总量＝每份数量×份数；298×3≈300×3＝900",
      "point": "乘法估算与实际问题",
      "tips": "把所需费用往大估后预算仍够，实际一定够；把所需费用往小估后仍超过预算，实际一定不够。若估算不能确定结论，应调整估算方法或精算。"
    }
  ]
