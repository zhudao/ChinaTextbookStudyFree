    {
      "point": "按一个标准分类",
      "core_concept": "分类前先确定标准，把具有相同特征的物品放在一类。",
      "key_formula": "分类标准一致，结果才便于比较。",
      "common_mistakes": [
        "同一次分类不要一会儿按颜色、一会儿按形状。"
      ],
      "tips": "说清楚你按什么标准分，再逐个检查。"
    },
    {
      "point": "不同标准与逐层分类",
      "core_concept": "同一组物品可以按不同标准分类，也可以先按一个标准分，再在每类中继续分类。",
      "key_formula": "先分类，再在每一类中按第二个标准细分。",
      "common_mistakes": [
        "换分类标准会改变分组，但不会改变物品总数。"
      ],
      "tips": "逐层分类时，要在每个大类中使用相同的第二个标准。"
    },
    {
      "point": "记录和比较分类结果",
      "core_concept": "分类后用数、符号或简单表格记录每类数量，再比较多少。",
      "key_formula": "总数=各类数量相加。",
      "common_mistakes": [
        "每件物品只记录一次，不重复也不遗漏。"
      ],
      "tips": "边数边做记号，最后用总数检查。"
    }
  ]
